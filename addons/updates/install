#!/bin/bash
#
# UNMM Updates Add-on
# Sob licença MIT
#
# Criador: João Paulo (o Jppgmx)
#

_addon_install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${_addon_install_dir}/../../lib/common.sh"
# Load INI configuration via confldr.py
load_config "${_addon_install_dir}/addon.conf"
# shellcheck source=config/addon
with_config ./config/addon
unset _addon_install_dir

#
#   Argumentos:
#   disk_device - Dispositivo de blocos no formato DISPOSITIVO:ARQUIVO:BACKEND.
#
addon_install() {
    local disk_device="$1"
    local ADDON_INSTALL_ARG_DEVICE image_path backend

    if [[ -n "$disk_device" ]]; then
        IFS=':' read -r ADDON_INSTALL_ARG_DEVICE image_path backend <<< "$disk_device"
    else
        ADDON_INSTALL_ARG_DEVICE="${ADDON_INSTALL_ARG_DEVICE:-}"
        image_path="${ADDON_INSTALL_ARG_DISKIMAGEPATH:-}"
        backend="${ADDON_INSTALL_ARG_BACKEND:-}"
    fi

    local ADDON_INSTALL_ARG_MOUNTPOINT="${ADDON_INSTALL_ARG_MOUNTPOINT:-${MOUNTPOINT:-${UNMM_GENERAL_MOUNT_POINT:-/mnt/unmm}}}"

    log_info "Atualizando o sistema operacional..."
    chroot_call_logged "$ADDON_INSTALL_ARG_MOUNTPOINT" apt-get update
    chroot_call_logged "$ADDON_INSTALL_ARG_MOUNTPOINT" apt-get upgrade -y
    chroot_call_logged "$ADDON_INSTALL_ARG_MOUNTPOINT" apt-get autoremove -y
    log_info "Sistema atualizado com sucesso."
}